[Unit]
Description=MOEX trading robot (paper by default)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingrobot
Group=tradingrobot
WorkingDirectory=/opt/tradingrobot
EnvironmentFile=-/etc/tradingrobot.env
ExecStart=/opt/tradingrobot/.venv/bin/python -m trading_robot.main --config /opt/tradingrobot/config/config.yaml
Restart=on-failure
RestartSec=5
# Реконнект брокера с экспоненциальной паузой реализован в самом роботе;
# systemd RestartSec — это перезапуск процесса целиком при фатальном сбое.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/tradingrobot/data
ProtectHome=true

[Install]
WantedBy=multi-user.target

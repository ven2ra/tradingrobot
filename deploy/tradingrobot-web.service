[Unit]
Description=MOEX trading robot - read-only web monitor
After=network-online.target tradingrobot.service
Wants=network-online.target

[Service]
Type=simple
User=tradingrobot
Group=tradingrobot
WorkingDirectory=/opt/tradingrobot
EnvironmentFile=-/etc/tradingrobot.env
ExecStart=/opt/tradingrobot/.venv/bin/python -m trading_robot.webui.server --config /opt/tradingrobot/config/config.yaml --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/opt/tradingrobot/data
ProtectHome=true

[Install]
WantedBy=multi-user.target

# Скопируйте в /etc/tradingrobot.env на сервере (chmod 600, владелец root).
# Здесь — реальные секреты. В config.yaml — только имена этих переменных.
#
# TINVEST_TOKEN=...
# TINVEST_ACCOUNT_ID=...
# LLM_API_KEY=...
#
# Basic Auth для read-only веб-панели (tradingrobot-web.service), если она
# слушает внешний адрес (0.0.0.0) — обязательны оба, иначе сервис не стартует
# на внешнем хосте. deploy.sh генерирует их автоматически при первом запуске.
# WEBUI_USER=admin
# WEBUI_PASSWORD=...
